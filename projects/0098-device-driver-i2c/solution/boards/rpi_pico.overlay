/*
 * boards/rpi_pico.overlay: this lesson's devices on the Pico.
 *
 *   GP14       push button, pressed = low (binding: dts/bindings/input/vnd,user-button.yaml)
 *   I2C0       GP4 = SDA, GP5 = SCL (the board's i2c0_default pinctrl), 400 kHz
 *   0x48       the MYS-1 sensor (binding: dts/bindings/sensor/vnd,mystery-sensor.yaml)
 */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

&i2c0 {
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";

	/* One child node per device on the bus. reg is the 7-bit address, so the node name
	 * mystery@48 repeats it by convention. */
	mystery: mystery@48 {
		compatible = "vnd,mystery-sensor";
		reg = <0x48>;
		label = "MYS-1";
	};
};

/ {
	buttons {
		user_button: button_0 {
			compatible = "vnd,user-button";
			gpios = <&gpio0 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Button";
		};
	};

	aliases {
		sw0 = &user_button;
	};
};
