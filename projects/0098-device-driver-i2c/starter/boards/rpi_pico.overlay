/*
 * boards/rpi_pico.overlay: this lesson's devices on the Pico.
 *
 *   GP14       push button, pressed = low. Written for you below.
 *   I2C0       GP4 = SDA, GP5 = SCL, from the board file, 400 kHz.
 *
 * TODO(learner): add the MYS-1 sensor at 0x48 under &i2c0, with the label "mystery", as in
 * lesson 98 (compatible "vnd,mystery-sensor", reg <0x48>). Put the binding file in
 * dts/bindings/sensor/vnd,mystery-sensor.yaml, with "include: i2c-device.yaml".
 */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	buttons {
		user_button: button_0 {
			compatible = "vnd,user-button";
			gpios = <&gpio0 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Button";
		};
	};

	aliases {
		sw0 = &user_button;
	};
};
