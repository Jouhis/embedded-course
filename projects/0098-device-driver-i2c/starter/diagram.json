{
  "version": 1,
  "author": "Embedded Course",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-pi-pico", "id": "pico", "top": 0, "left": 0, "attrs": {} },
    { "type": "chip-mystery", "id": "sensor", "top": 220, "left": -120, "attrs": {} },
    { "type": "wokwi-resistor", "id": "rSda", "top": 150, "left": 200, "rotate": 90, "attrs": { "value": "4700" } },
    { "type": "wokwi-resistor", "id": "rScl", "top": 170, "left": 240, "rotate": 90, "attrs": { "value": "4700" } },
    { "type": "wokwi-pushbutton", "id": "btn", "top": 60, "left": 300, "attrs": { "color": "green", "key": "b" } }
  ],
  "connections": [
    [ "pico:GP0", "$serialMonitor:RX", "", [] ],
    [ "pico:GP1", "$serialMonitor:TX", "", [] ],
    [ "pico:GP4", "sensor:SDA", "green", [ "v0" ] ],
    [ "pico:GP5", "sensor:SCL", "yellow", [ "v0" ] ],
    [ "pico:3V3", "sensor:VCC", "red", [ "v0" ] ],
    [ "pico:GND.1", "sensor:GND", "black", [ "v0" ] ],
    [ "pico:3V3", "rSda:1", "red", [ "v0" ] ],
    [ "rSda:2", "pico:GP4", "green", [ "v0" ] ],
    [ "pico:3V3", "rScl:1", "red", [ "v0" ] ],
    [ "rScl:2", "pico:GP5", "yellow", [ "v0" ] ],
    [ "pico:GP14", "btn:1.l", "blue", [ "h0" ] ],
    [ "btn:2.l", "pico:GND.2", "black", [ "h0" ] ]
  ],
  "dependencies": {}
}
