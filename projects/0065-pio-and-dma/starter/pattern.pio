; Lesson 65: show four-bit patterns that DMA feeds into the TX FIFO.
; pioasm turns this file into build/pattern.pio.h (a pio_program_t called pattern_program).
.program pattern
.wrap_target
    pull block          ; wait for a word from DMA
    out pins, 4 [31]    ; show its low four bits for 32 cycles
.wrap
