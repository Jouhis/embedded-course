{
  "version": 1,
  "author": "Embedded Course",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-pi-pico", "id": "pico", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": 120, "left": 200, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 150, "left": 160, "rotate": 90, "attrs": { "value": "330" } },
    { "type": "wokwi-pushbutton", "id": "btn", "top": 60, "left": 300, "attrs": { "color": "green", "key": "b" } }
  ],
  "connections": [
    [ "pico:GP0", "$serialMonitor:RX", "", [] ],
    [ "pico:GP1", "$serialMonitor:TX", "", [] ],
    [ "pico:GP16", "r1:1", "green", [ "h0" ] ],
    [ "r1:2", "led1:A", "green", [ "v0" ] ],
    [ "led1:C", "pico:GND.3", "black", [ "v0" ] ],
    [ "pico:GP14", "btn:1.l", "blue", [ "h0" ] ],
    [ "btn:2.l", "pico:GND.2", "black", [ "h0" ] ]
  ],
  "dependencies": {}
}
