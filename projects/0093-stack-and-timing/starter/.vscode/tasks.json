{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build firmware",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/../../../tools/build.py",
        "${workspaceFolder}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Clean build",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/../../../tools/build.py",
        "${workspaceFolder}",
        "--clean"
      ],
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}