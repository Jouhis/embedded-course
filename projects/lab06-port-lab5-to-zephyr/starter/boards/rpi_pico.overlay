/*
 * boards/rpi_pico.overlay: the devices of the Lab 6 monitor on the Pico.
 *
 * Written for you: the two buttons (sw0 = GP14, sw1 = GP15). Each is a node with the
 * compatible "vnd,user-button", so the binding in dts/bindings/input applies.
 *
 * TODO(learner): add the two I2C devices under &i2c0 (400 kHz, GP4 = SDA, GP5 = SCL):
 *   the SSD1306 OLED at 0x3C, label "oled", compatible "vnd,ssd1306-oled"
 *   the MYS-1 sensor at 0x48, label "mystery", compatible "vnd,mystery-sensor"
 * Use the fast bus: clock-frequency = <I2C_BITRATE_FAST>; and include
 * <zephyr/dt-bindings/i2c/i2c.h>. Then un-comment the BUILD_ASSERT lines in hal_zephyr.c.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	buttons {
		btn_a: button_a {
			compatible = "vnd,user-button";
			gpios = <&gpio0 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Button A";
		};
		btn_b: button_b {
			compatible = "vnd,user-button";
			gpios = <&gpio0 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Button B";
		};
	};

	aliases {
		sw0 = &btn_a;
		sw1 = &btn_b;
	};
};
