/*
 * boards/rpi_pico.overlay: the devices of the Lab 6 monitor on the Pico.
 *
 *   GP25       LED (led0, on the board, active high)
 *   GP14       button A (sw0), pressed = low, pull-up
 *   GP15       button B (sw1), pressed = low, pull-up
 *   I2C0       GP4 = SDA, GP5 = SCL, 400 kHz
 *   0x3C       SSD1306 OLED (node "oled")
 *   0x48       MYS-1 sensor, the mystery chip from lesson 63 (node "mystery")
 *
 * The C side checks these addresses at build time (BUILD_ASSERT in hal_zephyr.c), so a wrong
 * reg value here stops the build instead of failing on the bus.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

&i2c0 {
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";

	oled: ssd1306@3c {
		compatible = "vnd,ssd1306-oled";
		reg = <0x3c>;
		label = "OLED 128x64";
	};

	mystery: mystery@48 {
		compatible = "vnd,mystery-sensor";
		reg = <0x48>;
		label = "MYS-1";
	};
};

/ {
	buttons {
		btn_a: button_a {
			compatible = "vnd,user-button";
			gpios = <&gpio0 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Button A";
		};
		btn_b: button_b {
			compatible = "vnd,user-button";
			gpios = <&gpio0 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Button B";
		};
	};

	aliases {
		sw0 = &btn_a;
		sw1 = &btn_b;
	};
};
