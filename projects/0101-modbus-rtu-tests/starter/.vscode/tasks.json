{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build and run unit tests",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/../../../tools/build.py",
        "${workspaceFolder}",
        "--test"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}