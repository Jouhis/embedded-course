 *       buttons {
 *           user_button: button_0 { compatible = "vnd,user-button"; gpios = <&gpio0 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; label = "Button"; };
 *       };
 *       aliases { led1 = &led1; sw0 = &user_button; };
 *   };
 *
 * Then rebuild and find the new nodes in build/zephyr/zephyr.dts.
