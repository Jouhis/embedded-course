{
  "version": 1,
  "author": "Embedded Course",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-pi-pico", "id": "pico", "top": 0, "left": 0, "attrs": { "builder": "pico-sdk" } },
    { "type": "wokwi-led", "id": "led2", "top": -60, "left": 150, "attrs": { "color": "yellow" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 30, "left": 150, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 120, "left": 150, "attrs": { "color": "green", "label": "GP14" } }
  ],
  "connections": [
    [ "pico:GP0", "$serialMonitor:RX", "", [] ],
    [ "pico:GP1", "$serialMonitor:TX", "", [] ],
    [ "pico:GP15", "r1:1", "green", [ "h0" ] ],
    [ "r1:2", "led2:A", "green", [ "v0" ] ],
    [ "led2:C", "pico:GND.1", "black", [ "v0" ] ],
    [ "pico:GP14", "btn1:1.l", "orange", [ "h0" ] ],
    [ "btn1:2.l", "pico:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
